# Copy to .env.local and fill in. NEVER commit the populated file.
# This platform runs inference client-side; do NOT place secret tokens in any
# variable that is bundled into client code (e.g. NEXT_PUBLIC_*). Server-only
# variables stay unprefixed and are read solely in server contexts.

# Optional Hugging Face token for gated/private model downloads (server-side only).
HF_TOKEN=

# Base URL to self-host model weights instead of the public Hugging Face CDN.
# NEXT_PUBLIC_MODEL_HOST=
